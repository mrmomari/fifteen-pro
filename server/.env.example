# Copy to .env and fill in. Never commit the real .env file.

# ── Firebase Admin SDK ──
# Firebase Console → Project Settings → Service Accounts → Generate new
# private key. Paste the ENTIRE JSON file contents as a single line here
# (most hosts, including Hostinger's Node app env var editor, accept
# multi-line values fine — if yours doesn't, base64-encode it and set
# FIREBASE_SERVICE_ACCOUNT_BASE64 instead).
FIREBASE_SERVICE_ACCOUNT_JSON=
# FIREBASE_SERVICE_ACCOUNT_BASE64=

FIREBASE_PROJECT_ID=fifteen-pro

# ── Server ──
PORT=3000
# Comma-separated list of origins allowed to call this API from a browser.
# The live site + any preview channels you use.
ALLOWED_ORIGINS=https://15fifteen15.com,https://fifteen-pro.web.app

# ── SMTP (for the reminder digest + overdue-invoice emails) ──
# Hostinger gives you a mailbox on your own domain under hPanel → Emails.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_USER=notifications@15fifteen15.com
SMTP_PASS=
SMTP_FROM="Fifteen <notifications@15fifteen15.com>"

# ── Cron schedule (cron syntax, server's local time) ──
# Daily overdue-invoice sweep + reminder digest. Default: 8am daily.
CRON_SCHEDULE=0 8 * * *
