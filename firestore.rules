rules_version = '2';

// Firestore security rules for the fifteen-pro project.
// Paste into Firebase Console → Firestore Database → Rules → Publish.
// IMPORTANT: complete the setup steps in SECURITY.md BEFORE publishing,
// otherwise the admin dashboard will be locked out.

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    // Admins are Firebase Auth users listed in the admins collection
    // (doc id = the admin's auth UID). Managed from the Firebase console.
    function isAdmin() {
      return signedIn()
        && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    function isOwner(userId) {
      return signedIn() && request.auth.uid == userId;
    }

    // ── Admin registry ──
    match /admins/{uid} {
      allow get: if isOwner(uid);   // lets admin.html verify its own access
      allow list, write: if false;  // manage only from the Firebase console
    }

    // ── Public site content (read-only to visitors, writable by admin) ──
    match /settings/company {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/pricing {
      allow read: if true;
      allow write: if isAdmin();
    }
    // settings/access (partner logins), settings/notifications, etc.
    // are admin-only — the admin password no longer lives here.
    match /settings/{doc} {
      allow read, write: if isAdmin();
    }

    match /catalog/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /content/{doc} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ── Partner applications (index.html quiz/apply form) ──
    // Anyone may submit one; only admins can read or process them.
    match /applications/{id} {
      allow create: if request.resource.data.status == 'pending'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.keys().hasOnly(
             ['name','email','phone','website','industry','status','quizAnswers','createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // ── Shop orders (shop.html quote builder) ──
    // Anyone may submit one; only admins can read or process them.
    match /orders/{id} {
      allow create: if request.resource.data.status == 'new'
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.email is string
        && request.resource.data.email.size() > 0
        && request.resource.data.email.size() <= 200
        && request.resource.data.items is list
        && request.resource.data.items.size() > 0
        && request.resource.data.items.size() <= 50
        && request.resource.data.keys().hasOnly(
             ['name','email','phone','company','items','oneTimeTotal','monthlyTotal','status','source','createdAt']);
      allow read, update, delete: if isAdmin();
    }

    // ── Customers (portal accounts) ──
    match /customers/{uid} {
      allow read: if isAdmin() || isOwner(uid);
      allow write: if isAdmin();
    }

    // ── Services assigned to customers ──
    match /customerServices/{id} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      // Customers may request a service for themselves (status pending,
      // no milestones yet — those are admin-set); admins may assign anything.
      allow create: if isAdmin()
        || (isOwner(request.resource.data.userId)
            && request.resource.data.customerId == request.resource.data.userId
            && request.resource.data.status == 'pending'
            && request.resource.data.serviceId is number
            && request.resource.data.milestones is list
            && request.resource.data.milestones.size() == 0
            && request.resource.data.notes is string
            && request.resource.data.notes.size() <= 2000
            && request.resource.data.keys().hasOnly(
                 ['userId','customerId','customerName','serviceId','serviceName','phase','status',
                  'startDate','completionDate','milestones','notes','configuration','createdAt','requestedAt']));
      allow update, delete: if isAdmin();
    }

    // ── Support tickets ──
    match /tickets/{ticketId} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isOwner(request.resource.data.userId)
        && request.resource.data.status == 'open'
        && request.resource.data.subject is string
        && request.resource.data.subject.size() > 0
        && request.resource.data.subject.size() <= 300
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0
        && request.resource.data.message.size() <= 5000
        && request.resource.data.keys().hasOnly(
             ['userId','subject','category','message','status','createdAt','updatedAt']);
      allow update, delete: if isAdmin();

      // Reply thread — the ticket owner and admins can read it; the
      // ticket owner may only post as themselves ('customer'), admins
      // may only post as 'admin'. Replies are immutable once posted.
      match /replies/{replyId} {
        function ticketOwnerId() {
          return get(/databases/$(database)/documents/tickets/$(ticketId)).data.userId;
        }
        allow read: if isAdmin() || isOwner(ticketOwnerId());
        allow create: if (isAdmin()
              && request.resource.data.from == 'admin')
          || (isOwner(ticketOwnerId())
              && request.resource.data.from == 'customer'
              && request.resource.data.authorId == request.auth.uid);
        allow update, delete: if false;
      }
    }

    // ── Invoices ──
    // get is public (same link-trust model as contracts/questionnaires/
    // vendorQuotes: the doc id is unguessable and treated as the secret,
    // used by invoice.html?id=... so a sent invoice link actually shows
    // the invoice); list stays restricted so the collection can't be
    // browsed — portal.html's own "my invoices" query still works since
    // it's gated per-doc by isOwner.
    match /invoices/{id} {
      allow get: if true;
      allow list: if isAdmin() || isOwner(resource.data.userId);
      allow write: if isAdmin();
    }

    // ── Tasks (internal work backbone; optionally linked to a
    // customer + service) — admin-managed only ──
    match /tasks/{id} {
      allow read, write: if isAdmin();
    }

    // ── Discovery questionnaires (admin.html Questionnaires tab) ──
    // Each questionnaire is a unique link the admin sends to one customer/
    // prospect; anyone holding that link may open and fill it in without
    // logging in, but the collection can't be listed or browsed, and once
    // filled in it can no longer be edited by the respondent.
    match /questionnaires/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.status != 'completed'
            && request.resource.data.status == 'completed'
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['answers', 'status', 'completedAt', 'respondentName', 'respondentEmail']));
    }

    // ── Saved questionnaire analysis reports (admin.html Analyze) ──
    // Master editable report (internal + client-facing content, vendor
    // costs, markup). Strictly admin-only — never exposed via a link.
    match /qnReports/{id} {
      allow read, write: if isAdmin();
    }

    // ── Vendor cost quotes (report.html?vq=...) ──
    // A stripped-down service list (no customer identity, no internal
    // analysis, no our prices) the admin sends to a 3rd-party vendor with a
    // passcode. Anyone holding the link may fetch it by id (not list) and
    // submit costs exactly once; after that the doc is locked.
    match /vendorQuotes/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.status != 'submitted'
            && request.resource.data.status == 'submitted'
            && request.resource.data.costs is map
            && request.resource.data.diff(resource.data).affectedKeys()
                 .hasOnly(['costs', 'vendorName', 'vendorNote', 'status', 'submittedAt']));
    }

    // ── Customer activity timeline (maintained by server/, the optional
    // backend service — see server/README.md). No client, admin included,
    // ever writes this directly; it's synced from other collections by a
    // trusted server process using the Admin SDK, which bypasses these
    // rules entirely. Admins may read it once a UI is built to use it.
    match /customerTimeline/{customerId} {
      allow read: if isAdmin();
      allow write: if false;
      match /events/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // ── Vendor directory (admin.html Vendors tab) ──
    // Persistent vendor contact/specialty records — never exposed publicly
    // (distinct from the disposable per-report vendorQuotes cost sheet link).
    match /vendors/{id} {
      allow read, write: if isAdmin();
    }

    // ── Published client-facing roadmaps (report.html?cr=...) ──
    // Read-only snapshot of the polished engagement roadmap the admin
    // publishes and sends to the customer. Public get by direct id only.
    match /clientReports/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, update, delete: if isAdmin();
    }

    // ── Contract templates (admin.html Contracts tab) ──
    // Reusable contract templates (customer- or vendor-facing) that seed
    // new contract instances. Never exposed publicly — distinct from the
    // per-engagement contracts collection below.
    match /contractTemplates/{id} {
      allow read, write: if isAdmin();
    }

    // ── Contracts (admin.html Contracts tab + contract.html) ──
    // A contract instance sent to a customer or a 3rd-party vendor for
    // signature. Public get-by-id (same link-trust model as questionnaires/
    // vendorQuotes — the link itself is the secret, and the collection
    // can't be listed or browsed). The counterparty may sign exactly once
    // via a restricted update; the provider (admin) countersigns in-app
    // and may otherwise edit/delete freely.
    match /contracts/{id} {
      allow get: if true;
      allow list: if isAdmin();
      allow create, delete: if isAdmin();
      allow update: if isAdmin()
        || (resource.data.counterpartySignature == null
            && request.resource.data.counterpartySignature is map
            && request.resource.data.counterpartySignature.keys().hasOnly(['name','title','signedAt'])
            && request.resource.data.counterpartySignature.name is string
            && request.resource.data.counterpartySignature.name.size() > 0
            && request.resource.data.counterpartySignature.name.size() <= 200
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['counterpartySignature','status']));
    }

    // ── Audit logs (append-only) ──
    // Non-admins may only create the one legitimate self-service entry
    // shape (portal.html's "requested a service" log) — arbitrary
    // action/changes content from a customer is rejected so the audit
    // trail stays trustworthy.
    match /auditLogs/{id} {
      allow read: if isAdmin() || isOwner(resource.data.userId);
      allow create: if isAdmin()
        || (isOwner(request.resource.data.userId)
            && request.resource.data.action == 'request'
            && request.resource.data.resourceType == 'service'
            && request.resource.data.changes is map
            && request.resource.data.keys().hasOnly(
                 ['userId','action','resourceType','resourceId','changes','timestamp']));
      allow update, delete: if false;
    }

    // Everything else: denied.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
